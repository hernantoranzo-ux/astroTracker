<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de Ayuda y Soporte: las secciones se llenan en HelpFragment -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Astro.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_help" />

        <TextView
            style="@style/Astro.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="@string/help_subtitle" />

        <!-- Guía de conexión -->
        <LinearLayout
            style="@style/Astro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bluetooth"
                        android:tint="@color/blue_400" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Astro.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/help_guide_title" />

                    <TextView
                        style="@style/Astro.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/help_guide_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Solución de problemas -->
        <TextView
            style="@style/Astro.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_problems_title" />

        <LinearLayout
            android:id="@+id/problems_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical" />

        <!-- Preguntas frecuentes -->
        <TextView
            style="@style/Astro.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_faq_title" />

        <LinearLayout
            android:id="@+id/faq_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
