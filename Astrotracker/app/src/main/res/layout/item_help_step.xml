<?xml version="1.0" encoding="utf-8"?>
<!-- Un paso numerado de la guía de conexión. El círculo (tv_step_number) cambia de color en el último paso. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_step_row"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_step_number"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_step_circle"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_step_title"
            style="@style/Astro.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_step_body"
            style="@style/Astro.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.15" />
    </LinearLayout>
</LinearLayout>
