<?xml version="1.0" encoding="utf-8"?>
<!-- keepScreenOn: la pantalla NO se apaga mientras este fragmento está visible (control del telescopio) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Aviso: el Arduino está en automático -->
        <LinearLayout
            android:id="@+id/card_in_auto"
            style="@style/Astro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                style="@style/Astro.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/manual_in_auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/manual_back_to_manual" />
        </LinearLayout>

        <!-- Orientación del teléfono -->
        <LinearLayout
            style="@style/Astro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/Astro.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_phone_title"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Astro.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manual_azimuth" />

                    <TextView
                        android:id="@+id/tv_az"
                        style="@style/Astro.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_unknown"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Astro.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manual_altitude" />

                    <TextView
                        android:id="@+id/tv_alt"
                        style="@style/Astro.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_unknown"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sensor_note"
                style="@style/Astro.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/manual_phone_note" />
        </LinearLayout>

        <!-- Enlace y posición de motores -->
        <LinearLayout
            style="@style/Astro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/Astro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_link_title" />

            <TextView
                android:id="@+id/tv_link"
                style="@style/Astro.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Astro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/manual_motors_title" />

            <TextView
                android:id="@+id/tv_motors"
                style="@style/Astro.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_pos_unknown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_pos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/manual_request_pos" />
        </LinearLayout>

        <!-- D-pad -->
        <LinearLayout
            style="@style/Astro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/Astro.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_dpad_title"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_up"
                    style="@style/Astro.DPad"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="@string/cd_move_up"
                    app:icon="@drawable/ic_arrow_up" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_left"
                        style="@style/Astro.DPad"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:contentDescription="@string/cd_move_left"
                        app:icon="@drawable/ic_arrow_left" />

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_right"
                        style="@style/Astro.DPad"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:contentDescription="@string/cd_move_right"
                        app:icon="@drawable/ic_arrow_right" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_down"
                    style="@style/Astro.DPad"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="@string/cd_move_down"
                    app:icon="@drawable/ic_arrow_down" />
            </LinearLayout>

            <TextView
                style="@style/Astro.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/manual_dpad_legend" />

            <TextView
                style="@style/Astro.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/manual_dpad_hint" />
        </LinearLayout>

        <!-- Velocidad -->
        <LinearLayout
            style="@style/Astro.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/Astro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_speed_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speed_down"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/manual_speed_down" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speed_up"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/manual_speed_up" />
            </LinearLayout>
        </LinearLayout>

        <!-- Referencias -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_zero"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/manual_set_zero" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_max"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/manual_set_max" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_purple"
            android:text="@string/manual_go_auto" />
    </LinearLayout>
</ScrollView>
