<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del panel del menú lateral: slate oscuro casi opaco con borde derecho fino -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/drawer_bg" />
        </shape>
    </item>
    <item android:gravity="end" android:width="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
