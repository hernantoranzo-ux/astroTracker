<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de cada ítem del menú: el seleccionado lleva un "vidrio" azul redondeado con borde fino -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/blue_tint" />
                <stroke android:width="1dp" android:color="#663B82F6" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</selector>
